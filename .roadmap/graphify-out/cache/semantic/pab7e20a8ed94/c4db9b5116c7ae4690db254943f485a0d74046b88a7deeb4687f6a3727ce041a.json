{"nodes": [{"id": "roadmap_06_profile_settings_migration_0005_profile_settings", "label": "0005_profile_settings migration", "file_type": "document", "source_file": "06-profile-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_06_profile_settings_validate_username_change", "label": "validate_username_change() trigger", "file_type": "code", "rationale": "Cooldown enforced by the DB not the app so it cannot be bypassed; also rejects the placeholder username pattern as a change target.", "source_file": "06-profile-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_06_profile_settings_thirty_day_username_cooldown", "label": "30-day username change cooldown", "file_type": "concept", "source_file": "06-profile-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_06_profile_settings_check_blocked_on_message_insert", "label": "check_blocked_on_message_insert() trigger", "file_type": "code", "rationale": "messages_block_check BEFORE INSERT trigger prevents direct messages in either direction between blocked users; runs as SECURITY DEFINER because it needs cross-user reads of chat_members and user_blocks.", "source_file": "06-profile-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_06_profile_settings_block_user", "label": "block_user action", "file_type": "code", "rationale": "Blocking does NOT delete the chat (WhatsApp parity): it appears under a blocked filter, is excluded from profiles_visible search results and messaging is blocked in both directions by the DB trigger.", "source_file": "06-profile-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_06_profile_settings_schedule_account_deletion", "label": "schedule_account_deletion() RPC", "file_type": "code", "source_file": "06-profile-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_06_profile_settings_cleanup_deleted_accounts", "label": "cleanup-deleted-accounts scheduled function", "file_type": "code", "rationale": "Daily Netlify Scheduled Function hard-deletes expired accounts via auth.admin.deleteUser whose cascade handles profiles and message sender_id nullification per the #4a foreign keys.", "source_file": "06-profile-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_06_profile_settings_thirty_day_deletion_grace", "label": "30-day account deletion grace period", "file_type": "concept", "rationale": "MVP grace period with a globally visible banner and cancel button; actual deletion is a cascade from auth.users.", "source_file": "06-profile-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_06_profile_settings_avatar_gradient_algorithm", "label": "Deterministic avatar gradient (SHA-256)", "file_type": "code", "rationale": "SHA-256 hash of user_id modulo 12 fixed gradient palettes; no DB column, consistent across devices and immune to cache clears.", "source_file": "06-profile-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_06_profile_settings_optimize_avatar", "label": "avatar upload optimization flow", "file_type": "code", "rationale": "Client-side WebP compression to 512x512 quality 0.85 before upload per the #4a section 6.2 mandate; file_uploads row written before upload with status pending then completed.", "source_file": "06-profile-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_06_profile_settings_device_fingerprint", "label": "Device fingerprint (localStorage UUID)", "file_type": "code", "rationale": "crypto.randomUUID persisted in localStorage and sent to BFF on login; column is nullable because browsers with strict fingerprinting protection may clear localStorage.", "source_file": "06-profile-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_06_profile_settings_public_profile_screen", "label": "/profile/:username public profile", "file_type": "concept", "rationale": "Fetches from profiles_visible so column-level privacy settings automatically apply; Send message calls create_direct_chat_request.", "source_file": "06-profile-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_06_profile_settings_appearance_persistence", "label": "Theme persistence (localStorage + user_settings)", "file_type": "concept", "rationale": "Persisted in localStorage for instant pre-login application and server-side in user_settings for cross-device sync; login syncs server to localStorage.", "source_file": "06-profile-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "roadmap_06_profile_settings_validate_username_change", "target": "roadmap_04a_data_model_entities_profiles", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "06-profile-settings.md", "source_location": null, "weight": 1}, {"source": "roadmap_06_profile_settings_validate_username_change", "target": "roadmap_06_profile_settings_thirty_day_username_cooldown", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "06-profile-settings.md", "source_location": null, "weight": 1}, {"source": "roadmap_06_profile_settings_thirty_day_username_cooldown