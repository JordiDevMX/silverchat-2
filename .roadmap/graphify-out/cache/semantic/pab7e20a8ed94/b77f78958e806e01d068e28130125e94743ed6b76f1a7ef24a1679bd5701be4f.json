{"nodes": [{"id": "_roadmap_16_deployment_metadata_deployment_metadata", "label": "Deployment & Metadata (Prompt 16)", "file_type": "concept", "source_file": "16-deployment-metadata.md", "source_location": "#1 LOCKED DECISIONS", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Final prompt of the 16-section roadmap; adds no user-facing feature, makes the app production-ready. No analytics in MVP, *.netlify.app subdomain, manual pg_dump backups, migrations stay manual."}, {"id": "_roadmap_16_deployment_metadata_init_sentry", "label": "src/lib/sentry.ts (initSentry)", "file_type": "code", "source_file": "16-deployment-metadata.md", "source_location": "#4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "beforeSend filters errors from browser extensions and URLs containing access_token/refresh_token (magic link callbacks must never reach Sentry); ignoreErrors drops offline noise like 'Failed to fetch'."}, {"id": "_roadmap_16_deployment_metadata_sentry_vite_plugin", "label": "Sentry Vite plugin (source map upload)", "file_type": "code", "source_file": "16-deployment-metadata.md", "source_location": "#5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_16_deployment_metadata_sentry_integration", "label": "Sentry Error Tracking (free tier)", "file_type": "concept", "source_file": "16-deployment-metadata.md", "source_location": "#D1/#5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replay masks all text and blocks all media (privacy-first, no user content captured); tracesSampleRate 0.1 and 5% session replay to stay within the 5k events/month free tier. Backend Sentry integration deferred to Fase 2."}, {"id": "_roadmap_16_deployment_metadata_github_actions_ci", "label": "GitHub Actions CI workflow", "file_type": "code", "source_file": "16-deployment-metadata.md", "source_location": "#6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_16_deployment_metadata_netlify_toml", "label": "netlify.toml", "file_type": "code", "source_file": "16-deployment-metadata.md", "source_location": "#7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_16_deployment_metadata_security_headers", "label": "Security Headers (CSP, HSTS, X-Frame-Options)", "file_type": "concept", "source_file": "16-deployment-metadata.md", "source_location": "#7 headers", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CSP must allowlist Cloudflare Turnstile, Supabase, LiveKit, Sentry; frame-ancestors 'none' plus X-Frame-Options DENY is belt-and-suspenders for older browsers."}, {"id": "_roadmap_16_deployment_metadata_health_route", "label": "/health SPA route", "file_type": "code", "source_file": "16-deployment-metadata.md", "source_location": "#10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public route (not under _authenticated) so uptime monitors can reach it; kept for human debugging alongside the /api/health function which returns proper 200/503 codes."}, {"id": "_roadmap_16_deployment_metadata_api_health_function", "label": "netlify/functions/health.ts (/api/health)", "file_type": "code", "source_file": "16-deployment-metadata.md", "source_location": "#10 (function)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns 503 on degraded status because uptime monitors need non-200 to trigger alerts."}, {"id": "_roadmap_16_deployment_metadata_robots_txt", "label": "public/robots.txt", "file_type": "code", "source_file": "16-deployment-metadata.md", "source_location": "#11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App routes are disallowed - it is an auth-only app and indexing chat URLs is pointless; blocking avoids bots hammering routes that would 401 anyway."}, {"id": "_roadmap_16_deployment_metadata_sitemap_xml", "label": "public/sitemap.xml", "file_type": "code", "source_file": "16-deployment-metadata.md", "source_location": "#12", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_16_deployment_metadata_og_metadata", "label": "Open Graph / Twitter Card Metadata", "file_type": "concept", "source_file": "16-deployment-metadata.md", "source_location": "#9/index.html", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_16_deployment_metadata_env_example", "label": ".env.example (all vars)", "file_type": "code", "source_file": "16-deployment-metadata.md", "source_location": "#13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documents the VITE_ (public) vs server-side secret split: LiveKit/VAPID/Turnstile/Sentry secrets never reach the browser."}, {"id": "_roadmap_16_deployment_metadata_readme", "label": "README.md (rewritten)", "file_type": "document", "source_file": "16-deployment-metadata.md", "source_location": "#14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_16_deployment_metadata_deploy_doc", "label": "docs/DEPLOY.md", "file_type": "document", "source_file": "16-deployment-metadata.md", "source_location": "#15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_16_deployment_metadata_fase_2_doc", "label": "docs/FASE-2.md (deferred features)", "file_type": "document", "source_file": "16-deployment-metadata.md", "source_location": "#16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catalogues every deferred item across all 16 prompts so nothing is lost silently - prevents scope creep."}, {"id": "_roadmap_16_deployment_metadata_manual_pg_backup", "label": "Manual pg_dump Backup Policy", "fil