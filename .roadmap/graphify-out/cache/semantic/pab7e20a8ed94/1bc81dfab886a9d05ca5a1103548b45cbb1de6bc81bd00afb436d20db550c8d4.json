useActiveCall hook", "file_type": "code", "source_file": "12-calls.md", "source_location": "#5 FILE STRUCTURE", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_12_calls_use_livekit_room", "label": "useLiveKitRoom hook", "file_type": "code", "source_file": "12-calls.md", "source_location": "#13 HOOK", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Encapsulates entire LiveKit lifecycle; audio levels via LiveKit's built-in audioLevelChanged analyser instead of setInterval (less CPU); setCameraEnabled called after setMicrophoneEnabled to avoid publish-order issues on Safari."}, {"id": "_roadmap_12_calls_use_call_sounds", "label": "useCallSounds hook", "file_type": "code", "source_file": "12-calls.md", "source_location": "#7.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_12_calls_call_state_machine", "label": "Call State Machine", "file_type": "concept", "source_file": "12-calls.md", "source_location": "#L7 / #9 CALL LIFECYCLE", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Locked transitions: ringing -> answered -> ended / missed / declined / canceled; frontend marks missed at 15s, backend cron at 20s (network tolerance - client is more accurate when alive)."}, {"id": "_roadmap_12_calls_incoming_call_modal", "label": "IncomingCallModal component", "file_type": "code", "source_file": "12-calls.md", "source_location": "#8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_12_calls_outgoing_call_modal", "label": "OutgoingCallModal component", "file_type": "code", "source_file": "12-calls.md", "source_location": "#10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_12_calls_active_call_modal", "label": "ActiveCallModal (voice) component", "file_type": "code", "source_file": "12-calls.md", "source_location": "#11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_12_calls_active_video_call_modal", "label": "ActiveVideoCallModal component", "file_type": "code", "source_file": "12-calls.md", "source_location": "#12", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_12_calls_call_controls", "label": "CallControls component", "file_type": "code", "source_file": "12-calls.md", "source_location": "#11.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_12_calls_call_avatar", "label": "CallAvatar component", "file_type": "code", "source_file": "12-calls.md", "source_location": "#11.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_12_calls_call_formatter", "label": "callFormatter.ts (times, durations)", "file_type": "code", "source_file": "12-calls.md", "source_location": "#5/#6.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_12_calls_group_calls_by_day", "label": "groupCallsByDay", "file_type": "code", "source_file": "12-calls.md", "source_location": "#6.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_12_calls_permission_before_connect", "label": "Permissions Before LiveKit Connect", "file_type": "rationale", "source_file": "12-calls.md", "source_location": "#L6 / #9.1 / pitfalls", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "getUserMedia is requested BEFORE calling the Edge Function so denied-permission failures do not waste LiveKit tokens; no complex retry flow in MVP."}, {"id": "_roadmap_12_calls_ring_timeout", "label": "Ring Timeout (15s frontend / 20s cron)", "file_type": "rationale", "source_file": "12-calls.md", "source_location": "#L1 / cleanup cron / pitfalls", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frontend marks missed at 15s, backend cron only after 20s to account for network latency; client is authoritative when connected."}, {"id": "_roadmap_12_calls_busy_auto_reject", "label": "Busy Auto-Reject", "file_type": "concept", "source_file": "12-calls.md", "source_location": "#L12 / #7.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Incoming call while user is already in a call is immediately marked missed with reason 'busy', never shown to the user."}, {"id": "_roadmap_12_calls_peer_disconnect_detection", "label": "Peer Disconnect Detection (3s grace)", "file_type": "concept", "source_file": "12-calls.md", "source_location": "#9.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Waits 3s after participantDisconnected before ending the call so brief reconnects keep the call alive; room.disconnect() happens before the DB UPDATE to guarantee no orphaned media streams."}, {"id": "_roadmap_12_calls_remote_audio_level_waveform", "label": "Remote Audio Level Waveform", "file_type": "concept", "source_file": "12-calls.md", "source_location": "#11.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses LiveKit audioLevelChanged events (built-in analyser) updating callStore.remoteAudioLevel 0-100; CSS-only pulse ring preferred for cheapness and smoothness across devices."}, {"id": "_roadmap_12_calls_livekit_cloud", "label": "LiveKit Cloud", "file_type": "concept", "source_file": "12-calls.md", "source_location": "#1", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_roadmap_12_calls_calls_page", "target": "_roadmap_12_calls_use_calls", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "12-calls.md", "source_location": "#6.1", "weight": 1.0}, {"source": "_roadmap_12_calls_calls_page", "target": "_roadma