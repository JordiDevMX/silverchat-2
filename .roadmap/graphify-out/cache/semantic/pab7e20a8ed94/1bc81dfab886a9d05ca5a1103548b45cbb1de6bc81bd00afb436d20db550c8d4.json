{"nodes": [{"id": "_roadmap_12_calls_voice_video_calls", "label": "Voice & Video Calls Feature (LiveKit)", "file_type": "concept", "source_file": "12-calls.md", "source_location": "#1 LOCKED DECISIONS", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Last major roadmap feature; 1:1 calls only in MVP, LiveKit Cloud free tier (10k min/mo, 100 concurrent). Group calls, recording, screen sharing explicitly deferred to Fase 2."}, {"id": "_roadmap_12_calls_start_call", "label": "start_call RPC", "file_type": "code", "source_file": "12-calls.md", "source_location": "#2 MIGRATION 0013 (RPC START CALL)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atomic SECURITY DEFINER RPC: validates membership via is_chat_member, chat active via is_chat_active, direct/self chats only, no concurrent calls, generates room name 'call_{uuid}'."}, {"id": "_roadmap_12_calls_migration_0013", "label": "Migration 0013_calls_enhancements.sql", "file_type": "code", "source_file": "12-calls.md", "source_location": "#2 MIGRATION", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_12_calls_livekit_token_edge_function", "label": "livekit-token Edge Function", "file_type": "code", "source_file": "12-calls.md", "source_location": "#3 EDGE FUNCTION", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses service-role client to bypass RLS for the atomic call lookup; validates call active, <5 min old, caller is chat member; issues LiveKit AccessToken with 15-minute TTL."}, {"id": "_roadmap_12_calls_cleanup_stale_calls", "label": "cleanup_stale_calls cron", "file_type": "code", "source_file": "12-calls.md", "source_location": "#2 (cron reschedule)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_roadmap_12_calls_calls_page", "label": "CallsPage component", "file_type": "code", "source_file": 