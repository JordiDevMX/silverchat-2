{"nodes": [{"id": "roadmap_05_authentication_bff_architecture", "label": "BFF architecture (Netlify Functions)", "file_type": "rationale", "rationale": "SPAs cannot set httpOnly cookies from client-side JS, so a thin serverless layer handles only cookie-related auth ops; the client queries Supabase directly with a Bearer token and RLS still enforces security.", "source_file": "05-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_05_authentication_httponly_cookie_sessions", "label": "httpOnly cookie session model", "file_type": "concept", "rationale": "Refresh token in an HttpOnly Secure SameSite=Lax cookie immune to XSS exfiltration; access token held in JS memory only so XSS theft is limited to 1h; CSRF handled by SameSite plus Origin verification.", "source_file": "05-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_05_authentication_auth_signin", "label": "/api/auth/signin endpoint", "file_type": "code", "rationale": null, "source_file": "05-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_05_authentication_auth_refresh", "label": "/api/auth/refresh endpoint", "file_type": "code", "rationale": "Exchanges the refresh cookie for a new access token and rotates the refresh cookie (Supabase rotates on refresh).", "source_file": "05-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_05_authentication_auth_backup_code_verify", "label": "/api/auth/backup-code-verify endpoint", "file_type": "code", "rationale": "Server-side constant-time comparison of hashed backup codes; on success removes all MFA factors forcing re-enrollment because the TOTP device is presumed lost.", "source_file": "05-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_05_authentication_cloudflare_turnstile", "label": "Cloudflare Turnstile captcha", "file_type": "concept", "rationale": "Captcha on signup only; login is protected by the Supabase 30 emails per hour rate limit which is deemed sufficient.", "source_file": "05-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_05_authentication_totp_backup_codes", "label": "2FA: TOTP + 10 backup codes", "file_type": "concept", "rationale": "Settings-only (not offered in onboarding); backup codes are SHA-256 hashed client-side before insert (defense against DB leak) and compared server-side (client cannot be trusted for auth decisions).", "source_file": "05-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_05_authentication_two_factor_backup_codes", "label": "two_factor_backup_codes table", "file_type": "concept", "rationale": "Marking codes used and regeneration happen via service role (BFF) only; no client UPDATE or DELETE policies.", "source_file": "05-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_05_authentication_auth_token_manager", "label": "src/lib/auth.ts token manager", "file_type": "code", "rationale": "Access token in memory with deduplicated concurrent refreshes via a shared refreshPromise.", "source_file": "05-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_05_authentication_auth_provider_context", "label": "AuthProvider context", "file_type": "code", "rationale": "On mount calls /api/auth/refresh; hydrates user; routes redirect to /auth/2fa-verify when mfaRequired; auto-refresh interval every 50 minutes.", "source_file": "05-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_05_authentication_supabase_client_bearer_fetch", "label": "supabase.ts custom fetch (Bearer injection)", "file_type": "code", "rationale": "persistSession false and autoRefreshToken false are mandatory; otherwise the SDK writes tokens to localStorage defeating the BFF and two refresh mechanisms compete. Custom fetch injects the Bearer header and retries once on 401.", "source_file": "05-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_05_authentication_protected_routes", "label": "_authenticated protected route layout", "file_type": "code", "rationale": "beforeLoad redirects unauthenticated users to /auth/login with redirect param preservation; mfaRequired redirects to /auth/2fa-verify; full-screen skeleton while hydrating because skeleton feels faster than a spinner.", "source_file": "05-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_05_authentication_session_heartbeat", "label": "60s session heartbeat (presence)", "file_type": "code", "rationale": "Client-side interval updates profiles.last_seen_at every 60s; no Supabase Presence and no custom RPC needed since profiles RLS allows own-row update.", "source_file": "05-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_05_authentication_aal2_refresh_workaround", "label": "AAL2 refresh-token rotation workaround", "file_type": "rationale", "rationale": "Supabase does not expose a clean way to rotate cookies after MFA from a SPA; MVP calls POST /api/auth/refresh after mfa.verify to store the new session; dedicated /api/auth/mfa-complete endpoint documented as Fase 2.", "source_file": "05-authe