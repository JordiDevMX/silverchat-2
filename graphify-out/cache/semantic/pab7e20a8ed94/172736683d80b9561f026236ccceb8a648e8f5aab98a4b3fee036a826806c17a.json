{"nodes": [{"id": "roadmap_08a_chat_layout_messages_doc", "label": "Prompt #8a: Chat Layout, Message Rendering & Composer Specification", "file_type": "document", "source_file": ".roadmap/08a-chat-layout-messages.md", "source_location": "L1-L1175", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_08a_chat_layout_messages_migration_0008", "label": "Migration 0008: Message Mentions GIN Index & Profiles Realtime", "file_type": "code", "source_file": ".roadmap/08a-chat-layout-messages.md", "source_location": "L55-L92", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_08a_chat_layout_messages_chat_header_presence", "label": "ChatHeader & Polling Presence (useChatPresence)", "file_type": "rationale", "rationale": "Polls profiles_visible every 30s in direct chats and 60s in group chats because RLS on the underlying profiles table restricts Realtime row broadcasts to the profile owner.", "source_file": ".roadmap/08a-chat-layout-messages.md", "source_location": "L78-L89", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_08a_chat_layout_messages_message_list_scroll", "label": "MessageList Cursor Pagination & Scroll Preservation", "file_type": "rationale", "rationale": "Uses 50-message cursor pagination (created_at < oldest) without virtualization in MVP, restoring scroll offset via requestAnimationFrame on prepend and auto-scrolling on initial load to the unread marker or bottom.", "source_file": ".roadmap/08a-chat-layout-messages.md", "source_location": "L236-L325", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_08a_chat_layout_messages_message_bubble_grouping", "label": "MessageBubble & Consecutive Message Grouping (groupMessages.ts)", "file_type": "concept", "rationale": "Groups consecutive messages from the same sender within a 5-minute gap on the same calendar day using pure rounded-2xl bubbles without tails, signaling continuation via 1px vertical spacing.", "source_file": ".roadmap/08a-chat-layout-messages.md", "source_location": "L326-L416", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_08a_chat_layout_messages_message_content_subtypes", "label": "MessageContent Dispatcher & 9 Content Subtypes", "file_type": "code", "rationale": "Renders text (with linkify-react noopener/noreferrer/nofollow and @mentions), image (aspect-ratio reserved + MediaLightbox), video (poster + click-to-play), audio, file, sticker, location, contact, and system messages.", "source_file": ".roadmap/08a-chat-layout-messages.md", "source_location": "L417-L508", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_08a_chat_layout_messages_composer", "label": "Composer, Lazy Emoji Picker (frimousse) & @Mention Autocomplete", "file_type": "code", "rationale": "Provides an auto-resizing textarea with 500ms debounced draft saving, lazy-loaded frimousse emoji picker (~15 KB), 4-option AttachmentMenu, and group-only @mention autocomplete.", "source_file": ".roadmap/08a-chat-layout-messages.md", "source_location": "L547-L632", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_08a_chat_layout_messages_media_upload_flow", "label": "Client-Side Media Upload & Progress Flow (upload.ts / MediaPreviewModal)", "file_type": "rationale", "rationale": "Uses XMLHttpRequest instead of fetch to report upload progress and support AbortController cancellation, compressing images to WebP (max 2048px, 0.82 quality) and extracting video thumbnails client-side before inserting the message.", "source_file": ".roadmap/08a-chat-layout-messages.md", "source_location": "L633-L685", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_08a_chat_layout_messages_auto_mark_read", "label": "Auto-Mark-Read Triggers (useMarkAsRead)", "file_type": "rationale", "rationale": "Calls mark_chat_as_read RPC after 1000ms on initial load at bottom or 500ms when a new message arrives while at bottom and document is visible, never marking read while scrolled up.", "source_file": ".roadmap/08a-chat-layout-messages.md", "source_location": "L782-L799", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_08a_chat_layout_messages_optimistic_send", "label": "Optimistic Message Send & Status Computation (useSendMessage / messageStatus.ts)", "file_type": "rationale", "rationale": "Uses temp- prefixed IDs for optimistic messages and computes pending, sent, delivered, read, or failed status from message_receipts while skipping duplicate realtime INSERT echoes.", "source_file": ".roadmap/08a-chat-layout-messages.md", "source_location": "L751-L781", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "roadmap_08a_chat_layout_messages_doc", "target": "roadmap_08a_chat_layout_messages_migration_0008", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".roadmap/08a-chat-layout-messages.md", "source_location": "L55-L92", "weight": 1.0}, {"source": "roadmap_08a_chat_layout_messages_doc", "target": "roadmap_08a_chat_layout_messages_chat_header_presence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".roadmap/08a-chat-layout-messages.md", "source_location": "L188-L235", "weight": 1.0}, {"source": "roadmap_08a_chat_layout_messages_doc", "target": "roadmap_08a_chat_layout_messages_message_list_scroll", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".roadmap/08a-chat-layout-messages.md", "source_location": "L236-L325", "weight": 1.0}, {"source": "roadmap_08a_chat_layout_messages_doc", "target": "roadmap_08a_chat_layout_messages_message_bubble_grouping", "relation": "references", "confidence": "EXTRACTED", "c