{"nodes": [{"id": "roadmap_09_contact_profile_chat_settings_doc", "label": "Prompt #9: Contact Profile & Chat Settings Specification", "file_type": "document", "source_file": ".roadmap/09-contact-profile-chat-settings.md", "source_location": "L1-L1026", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_09_contact_profile_chat_settings_migration_0010", "label": "Migration 0010: Group Admin RPCs, Clear Chat & Shared Media Indexes", "file_type": "code", "rationale": "Provides SECURITY DEFINER RPCs for bulk adding members (silently skipping blocked users to avoid leaking block state), removing/promoting/demoting members (protecting group creator from demotion/removal), updating group info, and soft-clearing chat history via message_deletions.", "source_file": ".roadmap/09-contact-profile-chat-settings.md", "source_location": "L48-L269", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_09_contact_profile_chat_settings_chat_actions", "label": "Chat Action Availability Matrix & ChatOptionsMenu (chatActions.ts)", "file_type": "concept", "rationale": "Determines available chat-level actions by chat type (direct, group/community, self) and admin status, using muted_until = '9999-12-31T23:59:59Z' to represent 'Always muted'.", "source_file": ".roadmap/09-contact-profile-chat-settings.md", "source_location": "L303-L362", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_09_contact_profile_chat_settings_contact_profile_modal", "label": "ContactProfileModal (useContactProfile)", "file_type": "code", "rationale": "Renders an in-chat modal for a contact's profile using profiles_visible and LEAST/GREATEST direct_pair_key lookup, disabling Call/Video actions until a pending chat request is accepted.", "source_file": ".roadmap/09-contact-profile-chat-settings.md", "source_location": "L363-L401", "source_url": null, "captured_at": null, "author": null,