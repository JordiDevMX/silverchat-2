{"nodes": [{"id": "roadmap_05_authentication_netlify_bff_cookie_architecture", "label": "Netlify Functions BFF & HttpOnly Refresh Cookie Architecture", "file_type": "rationale", "source_file": ".roadmap/05-authentication.md", "source_location": "lines 44-335", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores long-lived Supabase refresh tokens in an HttpOnly, Secure, SameSite=Lax cookie managed by 6 Netlify Functions (auth-signin, auth-callback, auth-refresh, auth-logout, auth-turnstile-verify, auth-backup-code-verify) while holding the 1-hour access token only in JS memory to prevent XSS token exfiltration."}, {"id": "roadmap_05_authentication_client_auth_and_protected_routes", "label": "Client Token Manager, AuthProvider & _authenticated Route Guard", "file_type": "code", "source_file": ".roadmap/05-authentication.md", "source_location": "lines 336-594, 880-948", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Configures src/lib/supabase.ts with persistSession: false and custom 401 retry fetch via src/lib/auth.ts, hydrates session state in AuthProvider, guards protected routes via _authenticated.tsx, and runs a 60s presence heartbeat updating profiles.last_seen_at and devices."}, {"id": "roadmap_05_authentication_totp_2fa_and_backup_codes", "label": "TOTP 2FA Enrollment & SHA-256 Backup Codes (0004_auth_backup_codes.sql)", "file_type": "code", "source_file": ".roadmap/05-authentication.md", "source_location": "lines 712-836, 949-990", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combines Supabase Auth MFA TOTP enrollment with 10 client-generated, SHA-256-hashed single-use backup codes stored in public.two_factor_backup_codes and verified server-side via the BFF."}], "edges": [{"source": "roadmap_05_authentication_netlify_bff_cookie_architecture", "target": "roadmap_02_stack_setup_tanstack_router_spa_mode", "relation": "referen