null, "contributor": null}, {"id": "roadmap_06_profile_settings_account_deletion_grace_period", "label": "30-Day Account Deletion Grace Period & Scheduled Cleanup", "file_type": "rationale", "rationale": "Provides a 30-day reversible grace period via profiles.scheduled_deletion_at, a root-level PendingDeletionBanner, and a daily Netlify Scheduled Function (cleanup-deleted-accounts.ts) that calls supabaseAdmin.auth.admin.deleteUser to cascade delete profile and anonymize messages.", "source_file": ".roadmap/06-profile-settings.md", "source_location": "L33-L38", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_06_profile_settings_avatar_gradient", "label": "Deterministic SHA-256 Avatar Gradient (avatar.ts)", "file_type": "rationale", "rationale": "Computes a deterministic fallback gradient from the SHA-256 hash of user_id modulo 12 fixed palettes (AVATAR_GRADIENTS), avoiding a database column and staying consistent across devices and cache clears.", "source_file": ".roadmap/06-profile-settings.md", "source_location": "L259-L304", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_06_profile_settings_device_fingerprint", "label": "Device Fingerprinting & Session Management (devices.ts)", "file_type": "concept", "rationale": "Generates a persistent UUID in localStorage['silverchat_device_id'] with a nullable unique constraint (user_id, device_fingerprint) to tolerate strict browser privacy modes while supporting 'Sign out all other devices'.", "source_file": ".roadmap/06-profile-settings.md", "source_location": "L305-L330", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_06_profile_settings_social_links", "label": "Social Links Normalization (social-links.ts)", "file_type": "concept", "rationale": "Stores 5 fixed social platforms and up to 20 custom label/URL pairs in profiles.social_links JSONB so new fields require no schema migration.", "source_file": ".roadmap/06-profile-settings.md", "source_location": "L331-L370", "source_url": null, "captured_at": null, "contributor": null, "author": null}, {"id": "roadmap_06_profile_settings_avatar_upload", "label": "Client-Side WebP Avatar Upload & Crop Flow (avatar-upload.ts / AvatarPickerModal)", "file_type": "concept", "rationale": "Crops avatars via react-easy-crop and compresses client-side to 512x512 WebP (0.85 quality) via browser-image-compression before tracking in file_uploads and uploading to the avatars bucket.", "source_file": ".roadmap/06-profile-settings.md", "source_location": "L371-L398", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_06_profile_settings_privacy_visibility", "label": "Privacy Visibility Exclusions & Read Receipts Fair-Trade Rule", "file_type": "rationale", "rationale": "Controls photo and story visibility via Everyone, Contacts, Contacts Except (multi-select exclusions array), or Nobody, and enforces a bidirectional fair-trade rule when disabling read receipts.", "source_file": ".roadmap/06-profile-settings.md", "source_location": "L545-L596", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "roadmap_06_profile_settings_doc", "target": "roadmap_06_profile_settings_migration_0005", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".roadmap/06-profile-settings.md", "source_location": "L81", "weight": 1.0}, {"source": "roadmap_06_profile_settings_doc", "target": "roadmap_06_profile_settings_migration_0006", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".roadmap/06-profile-settings.md", "source_location": "L182", "weight": 1.0}, {"source": "roadmap_06_profile_settings_migration_0005", "target": "roadmap_06_profile_settings_validate_username_change", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".roadmap/06-profile-settings.md", "source_location": "L114-L143", "weight": 1.0}, {"source": "roadmap_06_profile_settings_migration_0005", "target": "roadmap_06_profile_settings_check_blocked_on_message_insert", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".roadmap/06-profile-settings.md", "source_location": "L144-L180", "weight": 1.0}, {"source": "roadmap_06_profile_settings_migration_0006", "target": "roadmap_06_profile_settings_account_deletion_grace_period", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".roadmap/06-profile-settings.md", "source_location": "L185-L220", "weight": 1.0}, {"source": "roadmap_06_profile_settings_doc", "target": "roadmap_06_profile_settings_avatar_gradient", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".roadmap/06-profile-settings.md", "source_location": "L259-L304", "weight": 1.0}, {"source": "roadmap_06_profile_settings_doc", "target": "roadmap_06_profile_settings_device_fingerprint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".roadmap/06-profile-settings.md", "source_location": "L305-L330", "weight": 1.0}, {"source": "roadmap_06_profile_settings_doc", "target": "roadmap_06_profile_settings_social_links", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".roadmap/06-profile-settings.md", "source_location": "L331-L370", "weight": 1.0}, {"source": "roadmap_06_profile_settings_doc", "target": "roadmap_06_profile_settings_avatar_upload", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".roadmap/06-profile-settings.md", "source_location": "L371-L398", "weight": 1.0}, {"source": "roadmap_06_profile_settings_doc", "target": "roadmap_06_profile_settings_privacy_visibility", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sou