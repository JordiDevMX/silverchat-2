{"nodes": [{"id": "roadmap_08b_message_actions_doc", "label": "Prompt #8b: Message Actions & Voice Notes Specification", "file_type": "document", "source_file": ".roadmap/08b-message-actions.md", "source_location": "L1-L1000", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_08b_message_actions_migration_0009", "label": "Migration 0009: Voice Peaks, Forward Tracking & 3-Pin Limit Trigger", "file_type": "code", "rationale": "Adds media_peaks and forwarded_from_message_id columns, publishes message_reactions to Realtime, and enforces the 3-pinned-messages-per-chat limit via check_pin_limit BEFORE UPDATE trigger to prevent race conditions.", "source_file": ".roadmap/08b-message-actions.md", "source_location": "L46-L103", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_08b_message_actions_action_matrix", "label": "Message Action Availability Matrix (actionMatrix.ts)", "file_type": "rationale", "rationale": "Pure function computing allowed message actions (reply, react, copy, forward, pin/unpin, edit within 15m, delete_for_me, delete_for_everyone within 1h) from message metadata and currentUserId.", "source_file": ".roadmap/08b-message-actions.md", "source_location": "L153-L210", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_08b_message_actions_context_menu", "label": "MessageContextMenu & useMessageActions Hook", "file_type": "code", "source_file": ".roadmap/08b-message-actions.md", "source_location": "L211-L256", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_08b_message_actions_reactions_system", "label": "ReactionsPicker & ReactionsDisplay (useReactions)", "file_type": "concept", "rationale": "Offers 8 fixed quick emojis plus full frimousse picker with 1 reaction per user per message (toggling same emoji deletes, choosing different emoji upserts) and live Realtime updates.", "sour