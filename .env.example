# =============================================================
# SilverChat — browser-safe environment variables
# =============================================================
# Only variables exposed to the browser go here, ALL prefixed VITE_.
#
# * VITE_SUPABASE_ANON_KEY is safe to expose ONLY because Row Level
#   Security (RLS) is enabled on the database (Prompt #04b). RLS is
#   load-bearing: never disable it.
# * Real values go in .env.local — it is gitignored, NEVER commit it.
# * Never put service_role keys, LiveKit API secrets, or Resend API
#   keys in VITE_* variables. Those live in Supabase Edge Function
#   secrets (server-side only).
# =============================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
