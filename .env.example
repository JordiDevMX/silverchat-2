# =============================================================
# SilverChat — browser and server environment variables
# =============================================================
# Only browser-safe variables are prefixed VITE_. Server variables follow below.
#
# * VITE_SUPABASE_ANON_KEY is safe to expose ONLY because Row Level
#   Security (RLS) is enabled on the database (Prompt #04b). RLS is
#   load-bearing: never disable it.
# * Real values go in .env.local — it is gitignored, NEVER commit it.
# * Never put service_role keys, LiveKit API secrets, or Resend API
#   keys in VITE_* variables. Auth secrets live in Netlify Functions
#   environment variables (server-side only).
# =============================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Server only: Netlify Functions environment, or ignored .env.local for netlify dev.
# Obtain Supabase values from Project Settings > API. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Cloudflare Dashboard > Turnstile. Restrict widget hostnames to your app domain.
TURNSTILE_SECRET_KEY=your-turnstile-secret
# Canonical HTTPS site origin and comma-separated exact browser origins (no trailing /).
SITE_URL=https://your-site.netlify.app
ALLOWED_ORIGINS=https://your-site.netlify.app

# =============================================================
# Supabase CLI, Turnstile site & secret keys — for local migration/type workflows (not the app).
# The turnstile keys are the test keys from Cloudflare, which are safe to commit. The real values go in .env.local.
# Find your ref in the dashboard URL (https://supabase.com/dashboard/
# project/<your-project-ref>) or Project Settings > General > Reference ID.
# Real value goes in .env.local. See docs/SUPABASE_CLI.md.
# =============================================================
SUPABASE_PROJECT_ID=<your-project-ref>
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# =============================================================
# Staging environment variables for local AI agents — for staging deployments (not the app).
# The staging Supabase project is a separate project from the main app.
# Real values go in .env.local. & .env files are gitignored
# =============================================================
STAGING_PROJECT_REF=<your-project-ref>
